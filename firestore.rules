rules_version = '2';

// Sicherheitsregeln für callsheet.
// - Nur eingeloggte Nutzer dürfen lesen/schreiben.
// - Rollen-Logik: Feld `role` im User-Dokument (admin | member).
//   Admins dürfen zusätzlich löschen.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User-Dokumente: jeder eingeloggte Nutzer darf lesen.
    // Schreiben nur das eigene Dokument; die Rolle nur als 'member' selbst setzen
    // (Hochstufung zu admin erfolgt manuell/durch Admin in der Console).
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Projektdaten: lesen + anlegen/ändern für alle eingeloggten Nutzer,
    // löschen nur für Admins.
    match /{coll}/{docId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }
  }
}

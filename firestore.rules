rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── AstroClub Planetenquiz (unverändert) ─────────────────────────────────
    match /scores/{doc} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                      'name',
                      'score',
                      'maxScore',
                      'percent',
                      'lang',
                      'quizId',
                      'durationSeconds',
                      'createdAt'
                    ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 160
                    && request.resource.data.maxScore == 160
                    && request.resource.data.percent is number
                    && request.resource.data.percent >= 0
                    && request.resource.data.percent <= 100
                    && (request.resource.data.lang == 'de' || request.resource.data.lang == 'en')
                    && request.resource.data.quizId == 'astroclub-planetenquiz'
                    && request.resource.data.durationSeconds is number
                    && request.resource.data.durationSeconds >= 0
                    && request.resource.data.durationSeconds <= 86400
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ─── callsheet (75-Jahr-Feier Waldorfschule Frankfurt) ────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User-Dokumente: eingeloggte Nutzer dürfen lesen; nur das eigene Dokument schreiben.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // Personen: löschen nur Admins (Team-Stamm soll stabil bleiben).
    match /people/{id} { allow read, create, update: if signedIn(); allow delete: if isAdmin(); }

    // Zeitplan, Aufgaben & Nachrichten/Feed: eingeloggte Nutzer dürfen voll arbeiten,
    // inkl. Löschen (Zugang ist bereits über die Namensliste eingeschränkt).
    match /scheduleBlocks/{id} { allow read, create, update, delete: if signedIn(); }
    match /tasks/{id}          { allow read, create, update, delete: if signedIn(); }
    match /comments/{id}       { allow read, create, update, delete: if signedIn(); }
  }
}
